; Heckler-Koch USP .45
;-(правлено SR)-------------------------------------
; калибр 				11.43x23 мм
; длина ствола 				97 мм
; магазин				12
; вес без магазина			0.726
; эффективная дальность стрельбы	60 м
; прицельная дальность			---
; дульная скорость пули			290 м/с
; темп стрельбы				30 в/м
;---------------------------------------------------
[wpn_usp]:identity_immunities,weapon_probability,default_weapon_params
GroupControlSection		= spawn_group
discovery_dependency 		=
$spawn 				= "weapons\usp"		; option for Level Editor
$npc			 	= on							; option for Level Editor
$prefetch 			= 8
scheduled 			= off 			; option for ALife Simulator
cform 				= skeleton
class 				= WP_USP45
min_radius 			= 1
max_radius 			= 10
description			= st_wpn_usp_descr

ef_main_weapon_type		= 0
ef_weapon_type			= 5

;---DOF-------------------------------------------------------------------------
zoom_dof			= -1000, 1.0, 1000 
reload_dof			= 0.0, 0.5, 5, 1.7
;-----------------------------------------------------------------------------

upgrades			= up_gr_ab_usp, up_gr_cd_usp, up_gr_e_usp, up_gr_f_usp, up_gr_g_usp
installed_upgrades		=
upgrade_scheme			= upgrade_scheme_u9

;--- scope weapons -------------------------------------------------------------
holder_range_modifier		= 1.0			; во сколько раз увеличивается eye_range
holder_fov_modifier		= 1.5			; во сколько раз увеличивается eye_fov
;-------------------------------------------------------------------------------

cost				= 2250

ammo_limit			= 120
ammo_current		 	= 96
ammo_elapsed		 	= 12
ammo_mag_size		 	= 12

ammo_class			= ammo_11.43x23_fmj, ammo_11.43x23_hydro

hand_dependence		 	= 1
single_handed			= 1

slot 			 	= 1             
animation_slot			= 1			; type of the animation that will be used

inv_name			= st_wpn_usp
inv_name_short			= st_wpn_usp
inv_weight			= 0.73

inv_grid_width			= 1
inv_grid_height			= 1
inv_grid_x			= 11
inv_grid_y			= 8

kill_msg_x			= 134
kill_msg_y			= 177
kill_msg_width			= 31
kill_msg_height			= 25

;-------------------------------------------------------------------------------
;базовая дисперсия
fire_dispersion_base		= 0.28 			;угол (в градусах) базовой дисперсии оружия (оружия зажатого в тисках)

;отдача
cam_relax_speed 		= 7			;скорость возврата в исходное положение
cam_dispersion 			= 1.0			;увеличения угла (в градусах) с каждым выстрелом
cam_dispersion_inc		= 1.0			;увеличениe cam_dispersion с каждым выстрелом
cam_dispersion_frac		= 1.0			;ствол будет подыматься на cam_dispersion*cam_dispersion_frac +- cam_dispersion*(1-cam_dispersion_frac)
cam_max_angle			= 10.0			;максимальный угол отдачи
cam_max_angle_horz		= 10.0			;(degree) maximum shot horizontal degree
cam_step_angle_horz		= 1.0			;(degree) size of step camera moved in horizontal position while shooting

fire_dispersion_condition_factor= 10			;увеличение дисперсии в процентах при максимальном износе
misfire_probability 		= 0.005	 		;вероятность осечки при максимальном износе
misfire_condition_k		= 0.05
condition_shot_dec 		= 0.00130		;увеличение износа при каждом выстреле
;-------------------------------------------------------------------------------

hud 				= wpn_usp_hud
position 			= -0.021, -0.085, 0.0
orientation 			= 0, 0, 0

fire_point 			= 0.0, 0.133, 0.161

flame_particles		 	= weapons\generic_weapon03
smoke_particles		 	= weapons\generic_shoot_00
grenade_flame_particles		= weapons\generic_weapon01

shell_point		 	= 0.0, 0.133, 0.047
shell_dir		 	= 0.0, 0.0, 0.4
shell_particles	 		= weapons\45acp

PDM_disp_base 			= 1.0
PDM_disp_vel_factor 		= 0.3
PDM_disp_accel_factor 		= 0.3
PDM_disp_crouch	 		= 1.0
PDM_disp_crouch_no_acc 		= 1.0

; ttc
hit_power			= 1.0, 1.0, 1.0, 1.0
hit_impulse	 		= 125
hit_type 			= fire_wound

fire_distance 			= 60
bullet_speed		 	= 290
rpm 				= 350
rpm_empty_click 	 	= 250
; end ttc

use_aim_bullet			= true			; Поддерживается ли первая суппер пуля
time_to_aim			= 1.0

;--STRAP PARAMETERS-----------------------------------------------------------------
;strap_position 		= -0.1, -0.45, 0.2	; position (offset) and orientation of the weapon when it is strapped
;strap_orientation 		= 1.57,0,0						; (3rd person view)
;strap_bone0			= bip01_spine2
;strap_bone1			= bip01_spine1

startup_ammo 			= 90

visual 				= dynamics\weapons\wpn_usp45\wpn_usp45.ogf

light_color		 	= 0.6, 0.5, 0.3
light_range		 	= 3.0
light_var_color		 	= 0.05
light_var_range		 	= 0.5
light_time 		 	= 0.2

ph_mass			 	= 1

;addons
scope_status			= 0
silencer_status			= 2
grenade_launcher_status		= 0

zoom_enabled			= true
scope_zoom_factor		= 55

silencer_name 			= wpn_addon_silencer		; section name for the attachable silencer
silencer_x 			= 39						; offset in inventory icon
silencer_y 			= -16

;звуки
snd_draw		= weapons\usp45\usp45_draw
snd_holster		= weapons\pistol_holster
snd_shoot		= weapons\usp45\usp45_shoot
snd_shoot1		= weapons\usp45\usp45_shoot1
snd_shoot2		= weapons\usp45\usp45_shoot2
snd_silncer_shot	= weapons\usp45\usp45_shoot_sil
snd_empty		= weapons\usp45\usp45_empty
snd_reload		= weapons\usp45\usp45_reload_empty
snd_shoot_grenade       = weapons\gen_grenshoot
snd_reload_grenade      = weapons\gen_grenload, 1.0, 0.8
snd_switch              = weapons\groza_switch, 1.0, 0.5
snd_bore		= weapons\draw_silent
snd_bore1		= weapons\draw_silent


;params when silencer is attached
;similar to corresponding params without prefix silencer_

;silencer_flame_particles 	= weapons\generic_weapon01
silencer_smoke_particles 	= weapons\generic_shoot_00

silencer_hit_power 		= 0.9, 0.9, 0.9, 0.9
silencer_hit_impulse	 	= 125
silencer_fire_distance 		= 57
silencer_bullet_speed	 	= 276

silencer_light_color		= 0.6, 0.5, 0.3
silencer_light_range		= 0.01
silencer_light_var_color	= 0.05
silencer_light_var_range	= 0.5
silencer_light_time 		= 0.2

[wpn_usp_hud]:hud_base

zoom_hide_crosshair		= true ;
item_visual             	= dynamics\weapons\wpn_usp45\wpn_usp45_hud.ogf
attach_place_idx		= 0

hands_position			= 0.033,-0.1895,0.039
hands_orientation		= 2,2,0
hands_position_16x9		= 0.033,-0.1895,0.039
hands_orientation_16x9		= 2,2,0

item_position			= 0,0,0
item_orientation		= 0,0,0

shell_point			= 0,0,0
shell_bone              	= gilza


fire_point			= 0,0,0
fire_bone               	= muzzle

anm_show			= usp45_draw
anm_show_empty			= usp45_draw, opened
anm_hide            		= usp45_holster
anm_hide_empty			= usp45_holster, opened
		
anm_idle            		= usp45_idle
anm_idle_empty      		= usp45_idle, opened
anm_shots			= usp45_shoot, shoot
anm_shot_l			= usp45_shoot, shoot_last
anm_idle_aim			= usp45_idle_aim
anm_idle_aim_empty		= usp45_idle_aim, opened
		
anm_reload			= usp45_reload, reload
anm_reload_empty		= usp45_reload_empty, reload_empty
anm_idle_moving			= usp45_idle_moving
anm_idle_moving_empty		= usp45_idle_moving, opened
anm_idle_sprint			= usp45_idle_sprint
anm_idle_sprint_empty		= usp45_idle_sprint, opened
anm_bore			= usp45_idle_aim
anm_bore_empty			= usp45_idle_aim, opened


aim_hud_offset_pos = -0.151000,0.069800,-0.150000
aim_hud_offset_rot = 0.024800,0.035300,0.000000

aim_hud_offset_pos_16x9 = -0.151000,0.069800,-0.150000
aim_hud_offset_rot_16x9 = 0.024800,0.035300,0.000000

gl_hud_offset_pos			= 0,0,0
gl_hud_offset_rot			= 0,0,0

lean_hud_offset_pos			= 0,0,0
lean_hud_offset_rot			= 0,0,0

