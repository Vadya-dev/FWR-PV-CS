smoke_particles		  	= weapons\generic_shoot_00

PDM_disp_base 			= 1.0
PDM_disp_vel_factor 		= 1.1
PDM_disp_accel_factor	 	= 1.1
PDM_disp_crouch	 		= 1.0
PDM_disp_crouch_no_acc 		= 1.0

; ttc
hit_power			= 1.0, 1.0, 1.0, 1.0
hit_impulse 			= 150
hit_type 			= explosion

fire_distance 			= 380
bullet_speed			= 73.5
rpm 				= 200
rpm_empty_click 	 	= 200
; end ttc

