; Револьверный ручной гранатомет 6Г30
;-(правлено SR)-------------------------------------
; калибр 				40 мм
; длина ствола 				---
; количество стволов			6
; вес без магазина			6.2
; эффективная дальность стрельбы	380 м
; прицельная дальность			---
; начальная скорость гранаты		73.5 м/с
; темп стрельбы				12-15 в/с
; ресурс живучести			2500-3000 выстрелов
;---------------------------------------------------
[wpn_rg-6]:zero_immunities,weapon_probability,default_weapon_params
GroupControlSection		= spawn_group
discovery_dependency 		=
$spawn				= "weapons\rg-6"		; option for Level Editor
$npc				= on						; option for Level Editor
$prefetch 			= 2
scheduled			= off 				; option for ALife Simulator
cform				= skeleton
class				= WP_RG6
min_radius			= 20
max_radius			= 50
description			= st_wpn_rg6_descr

ef_main_weapon_type		= 4
ef_weapon_type			= 9

sprint_allowed			= false
tri_state_reload		= on

;---DOF-------------------------------------------------------------------------
zoom_dof			= 0.5, 1.0, 180
reload_dof 			= 0.0, 0.5,5, 1.7
;-------------------------------------------------------------------------------

;-------------------------------------------------------------------------------
holder_range_modifier		= 1.0				; во сколько раз увеличивается eye_range
holder_fov_modifier		= 1.0				; во сколько раз увеличивается eye_fov
;-------------------------------------------------------------------------------

cost				= 10000
weapon_class			= heavy_weapon

ammo_limit			= 60
ammo_current	 		= 10
ammo_elapsed	 		= 0
ammo_mag_size	 		= 6

ammo_class			= ammo_vog-25, ammo_vog-25p

grenade_vel 			= 73.5
launch_speed			= 73.5

hand_dependence 		= 2
single_handed			= 0

slot 				= 2
animation_slot			= 10

inv_name			= st_wpn_rg6
inv_name_short			= st_wpn_rg6
inv_weight			= 6.2

inv_grid_width			= 4
inv_grid_height			= 2
inv_grid_x			= 0
inv_grid_y			= 8

kill_msg_x			= 0
kill_msg_y			= 172
kill_msg_width			= 68
kill_msg_height			= 30

;-------------------------------------------------------------------------------
;базовая дисперсия
fire_dispersion_base		= 1.0 		;угол (в градусах) базовой дисперсии оружия (оружия зажатого в тисках)
control_inertion_factor		= 1.7f

;отдача
cam_relax_speed			= 7.0		;скорость возврата в исходное положение
cam_relax_speed_ai		= 360
cam_dispersion			= 5.0 		;увеличения угла (в градусах) с каждым выстрелом
cam_dispersion_inc		= 5.0 		;увеличениe cam_dispersion с каждым выстрелом
cam_dispersion_frac		= 0.1 		;ствол будет подыматься на cam_dispersion*cam_dispersion_frac +- cam_dispersion*(1-cam_dispersion_frac)
cam_max_angle			= 15 		;максимальный угол отдачи
cam_max_angle_horz		= 5 		;(degree) maximum shot horizontal degree
cam_step_angle_horz		= 5.0 		;(degree) size of step camera moved in horizontal position while shooting

fire_dispersion_condition_factor= 2		;увеличение дисперсии в процентах при максимальном износе 
misfire_probability 		= 0.0003	;вероятность осечки при максимальном износе 
misfire_condition_k		= 0.05 
condition_shot_dec 		= 0.0004	;увеличение износа при каждом выстреле
;-------------------------------------------------------------------------------

hud				= wpn_rg-6_hud
position			= -0.026, -0.111, 0.
orientation			= 0, 0, 0

shell_point			= 0.0, 0.120, 0.20
fire_point			= 0.0, 0.120, 0.452
fire_point2			= 0.0, 0.120, 0.452

