anm_bore_g		= m4_idle_aim_g, idle_g

aim_hud_offset_pos = -0.113500,0.033000,-0.100000
aim_hud_offset_rot = 0.036500,0.034700,0.000000

aim_hud_offset_pos_16x9 = -0.113500,0.033000,-0.100000
aim_hud_offset_rot_16x9 = 0.036500,0.034700,0.000000

gl_hud_offset_pos	 = -0.105000,-0.005000,0.100000
gl_hud_offset_rot	 = -0.006000,0.024000,0.000000

gl_hud_offset_pos_16x9 = -0.105000,-0.005000,0.100000
gl_hud_offset_rot_16x9 = -0.006000,0.024000,0.000000

lean_hud_offset_pos        = 0,0,0
lean_hud_offset_rot        = 0,0,0

