; Штурмовой карабин (автомат) Z-M LR300
;-(правлено SR)-------------------------------------
; калибр 				5.56x45 мм
; длина ствола 				292 мм
; магазин				30
; вес без магазина			3.1
; эффективная дальность стрельбы	300 м
; прицельная дальность			---
; дульная скорость пули			910 м/с
; темп стрельбы				950 в/с
;---------------------------------------------------
[wpn_lr300]:identity_immunities,weapon_probability,default_weapon_params
GroupControlSection		= spawn_group
discovery_dependency		=
$spawn				= "weapons\lr-300"	; option for Level Editor
$npc 				= on			; option for Level Editor
$prefetch			= 8
scheduled			= off			; option for ALife Simulator
cform				= skeleton
class				= WP_AK74
min_radius			= 5
max_radius			= 100
description			= st_wpn_lr300_descr

ef_main_weapon_type		= 2
ef_weapon_type			= 6

;---DOF-------------------------------------------------------------------------
zoom_dof			= 0.5, 1.0, 180
reload_dof			= 0.0, 0.5, 5, 1.7
;-------------------------------------------------------------------------------

upgrades			= up_gr_ab_lr300, up_gr_cd_lr300, up_gr_ef_lr300, up_gr_gh_lr300, up_gr_i_lr300, up_gr_j_lr300
installed_upgrades		=
upgrade_scheme			= upgrade_scheme_u16a

;-------------------------------------------------------------------------------
holder_range_modifier		= 1.0			; во сколько раз увеличивается eye_range
holder_fov_modifier		= 1.0			; во сколько раз увеличивается eye_fov
;-------------------------------------------------------------------------------

cost 				= 6000
weapon_class			= assault_rifle

fire_modes 			= 1, 3, -1

ammo_limit			= 210
ammo_current			= 30
ammo_elapsed			= 30
ammo_mag_size 			= 30			; clip (magazine) size

ammo_class		 	= ammo_5.56x45_ss190, ammo_5.56x45_ap
grenade_class			= ammo_m209

launch_speed			= 73.5

hand_dependence			= 2
single_handed			= 0

slot 				= 2			; // secondary
animation_slot			= 2			; type of the animation that will be used

inv_name 			= st_wpn_lr300
inv_name_short			= st_wpn_lr300
inv_weight			= 3.1

inv_grid_width			= 5
inv_grid_height			= 2
inv_grid_x			= 0
inv_grid_y			= 6

kill_msg_x			= 175
kill_msg_y			= 0
kill_msg_width			= 82
kill_msg_height			= 28

;-------------------------------------------------------------------------------
;базовая дисперсия
fire_dispersion_base		= 0.22 		;угол (в градусах) базовой дисперсии оружия (оружия зажатого в тисках)
control_inertion_factor		= 1.2f

;отдача
cam_relax_speed 		= 5		;скорость возврата в исходное положение
cam_relax_speed_ai 		= 360
cam_dispersion 			= 0.2		;увеличения угла (в градусах) с каждым выстрелом
cam_dispersion_inc 		= 0.2		;увеличениe cam_dispersion с каждым выстрелом
cam_dispersion_frac 		= 0.7		;ствол будет подыматься на cam_dispersion*cam_dispersion_frac +- cam_dispersion*(1-cam_dispersion_frac)
cam_max_angle 			= 10.0 		;максимальный угол отдачи
cam_max_angle_horz 		= 10.0		;(degree) maximum shot horizontal degree
cam_step_angle_horz 		= 1.2		;(degree) size of step camera moved in horizontal position while shooting

zoom_cam_relax_speed		= 5		; scope & ironsight
zoom_cam_relax_speed_ai		= 360
zoom_cam_dispersion		= 0.1
zoom_cam_dispersion_inc		= 0.1
zoom_cam_dispersion_frac	= 0.7
zoom_cam_max_angle		= 7.0
zoom_cam_max_angle_horz		= 7.0
zoom_cam_step_angle_horz	= 1.0

fire_dispersion_condition_factor= 8		;увеличение дисперсии в процентах при максимальном износе
misfire_probability 		= 0.0001	;вероятность осечки при максимальном износе
misfire_condition_k		= 0.05
condition_shot_dec 		= 0.0002	;увеличение износа при каждом вvстреле
;-------------------------------------------------------------------------------

hud				= wpn_lr300_hud
position			= -0.026, -0.130, 0.0
orientation			= 0.0, 0.0, 0.0

fire_point			= 0.0, 0.199, 0.575
fire_point2			= 0.0, 0.199, 0.575

flame_particles			= weapons\generic_weapon05
smoke_particles			= weapons\generic_shoot_00
grenade_flame_particles		= weapons\generic_weapon01

shell_point			= 0.120000,0.000000,0.070000
shell_dir			= 0.0, 0.0, 0.4
shell_particles			= weapons\556x45


PDM_disp_base			= 1.0
PDM_disp_vel_factor 		= 1.3
PDM_disp_accel_factor 		= 1.3
PDM_disp_crouch	 		= 1.0
PDM_disp_crouch_no_acc 		= 1.0

; ttc
hit_power			= 1.0, 1.0, 1.0, 1.0
hit_impulse			= 100
hit_type			= fire_wound

fire_distance			= 300
bullet_speed			= 910			; начальная скорость пули
rpm				= 950
rpm_empty_click			= 200
; end ttc

use_aim_bullet			= false			; Поддерживается ли первая суппер пуля
time_to_aim			= 2.0

;--STRAP PARAMETERS-----------------------------------------------------------------
;под мишкой
strap_position 			= -0.15,-0.37,0.2	; position (offset) and orientation of the weapon when it is strapped
strap_orientation 		= -10,-5,10		; (3rd person view in degrees)
strap_bone0			= bip01_spine2
strap_bone1			= bip01_spine1

startup_ammo			= 90
visual				= dynamics\weapons\wpn_lr300\wpn_lr300.ogf

light_disabled			= false
light_color			= 0.6,0.5,0.3
light_range			= 5
light_var_color			= 0.05
light_var_range			= 0.1
light_time			= 0.2

ph_mass				= 3

;addons
scope_status			= 2			; 0 - no addon
silencer_status			= 2			; 1 - permanent
grenade_launcher_status		= 0			; 2 - attachable

zoom_enabled			= true			; (on,off)zoom mode (right mouse button)
scope_zoom_factor		= 50			; fov for zoom mode
scope_texture			= wpn_crosshair_l85

scope_name 			= wpn_addon_scope_susat
scope_x 			= 75
scope_y 			= -5

silencer_name			= wpn_addon_silencer	; section name for the attachable silencer
silencer_x			= 210			; offset in inventory icon
silencer_y			= 9

grenade_launcher_name		= wpn_addon_grenade_launcher_m203	; section name for the attachable grenade launcher
grenade_launcher_x		= 128					; offset in inventory icon
grenade_launcher_y		= 28

;звуки
snd_draw                = weapons\rifle_draw
snd_holster             = weapons\rifle_holster
snd_shoot               = weapons\lr300\lr300_shoot
snd_shoot1              = weapons\lr300\lr300_shoot1
snd_shoot2              = weapons\lr300\lr300_shoot2
snd_silncer_shot        = weapons\lr300\lr300_shoot_sil
snd_empty               = weapons\gen_empty, 0.5
snd_reload		= weapons\lr300\lr300_reload_empty
snd_shoot_grenade       = weapons\m203_grenshoot
snd_reload_grenade      = weapons\m203_grenload
snd_switch              = weapons\m203_switch
snd_bore		= weapons\draw_silent
snd_bore1		= weapons\draw_silent

silencer_smoke_particles	= weapons\generic_shoot_00

silencer_hit_power 		= 0.9, 0.9, 0.9, 0.9
silencer_hit_impulse	 	= 100
silencer_fire_distance 		= 139
silencer_bullet_speed	 	= 290

silencer_light_color		= 0.6,0.5,0.3
silencer_light_range		= 0.01
silencer_light_var_color	= 0.05
silencer_light_var_range	= 0.5
silencer_light_time		= 0.2

[wpn_lr300_hud]
zoom_hide_crosshair        	= true
attach_place_idx        	= 0
item_visual                	= dynamics\weapons\wpn_lr300\wpn_lr300_hud.ogf

hands_position			= -0.044,-0.18,0.14
hands_orientation		= 2,2,0
hands_position_16x9		= -0.044,-0.18,0.14
hands_orientation_16x9		= 2,2,0

item_position			= 0,0,0
item_orientation		= 0,0,0

shell_point		= 0,0,0
shell_dir       	= 0.0, 1.0, 0.0
shell_bone		= gilza

fire_point		= 0,0,0
fire_bone      		= muzzle
fire_point2		= 0,0,0
fire_bone2		= muzzle_gl

anm_show             	= m4_draw
anm_hide             	= m4_holster
anm_idle             	= m4_idle
anm_idle_sprint         = m4_idle_sprint
anm_idle_moving 	= m4_idle_moving
anm_shots               = m4_shoot, shoot
anm_reload	        = m4_reload_empty, reload_empty
anm_idle_aim           	= m4_idle_aim
	
anm_switch             	= m4_switch_off, switch_off
anm_switch_g           	= m4_switch_on, switch_on
anm_bore		= m4_idle_aim
	
anm_hide_w_gl           = m4_holster_w_gl
anm_show_w_gl           = m4_draw_w_gl
anm_idle_w_gl           = m4_idle_w_gl
anm_shots_w_gl          = m4_shoot_w_gl, shoot_w_gl
anm_reload_w_gl   	= m4_reload_empty_w_gl, reload_empty_w_gl
anm_idle_w_gl_aim       = m4_idle_aim_w_gl
anm_idle_sprint_w_gl	= m4_idle_sprint_w_gl
anm_idle_moving_w_gl	= m4_idle_moving_w_gl
