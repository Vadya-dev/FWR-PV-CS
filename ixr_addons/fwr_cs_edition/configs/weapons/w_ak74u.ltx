control_inertion_factor		= 1.1f

;отдача
cam_relax_speed			= 5			;скорость возврата в исходное положение
cam_relax_speed_ai 		= 120.75
cam_dispersion			= 0.5			;увеличения угла (в градусах) с первым выстрелом
cam_dispersion_inc		= 0.5			;увеличениe cam_dispersion с каждым выстрелом
cam_dispersion_frac		= 0.7			;ствол будет подыматься на cam_dispersion*cam_dispersion_frac +- cam_dispersion*(1-cam_dispersion_frac)
cam_max_angle			= 5.0			;максимальный угол отдачи
cam_max_angle_horz		= 10.0			;(degree) maximum shot horizontal degree
cam_step_angle_horz		= 1.5			;(degree) size of step camera moved in horizontal position while shooting

zoom_cam_relax_speed		= 5			; scope & ironsight
zoom_cam_relax_speed_ai		= 360
zoom_cam_dispersion		= 0.5
zoom_cam_dispersion_inc		= 0.5
zoom_cam_dispersion_frac	= 0.7
zoom_cam_max_angle		= 5.0
zoom_cam_max_angle_horz		= 5.0
zoom_cam_step_angle_horz	= 1.0

fire_dispersion_condition_factor= 10			;увеличение дисперсии в процентах при максимальном износе
misfire_probability		= 0.0001		;вероятность осечки при максимальном износе
misfire_condition_k		= 0.05
condition_shot_dec		= 0.0001		;увеличение износа при каждом выстреле
