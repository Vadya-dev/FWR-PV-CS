; Автомат Калашникова укороченый АКС-74У (6П26)
;-(правлено SR)-------------------------------------
; калибр				5.45х39
; длина ствола 				210 мм
; магазин				30/45
; вес без магазина			2.71
; эффективная дальность стрельбы	200 м
; прицельная дальность			400 м
; дульная скорость пули			735 м/с
; темп стрельбы				650-735
;---------------------------------------------------
[wpn_ak74u]:identity_immunities,weapon_probability,default_weapon_params
GroupControlSection		= spawn_group
discovery_dependency		=
$spawn 				= "weapons\ak-74u"	; name and section in level editor
$npc 				= on
$prefetch			= 8
scheduled			= off			; option for ALife Simulator
cform				= skeleton
class				= WP_AK74		; class of the weapon that corresponding to CPP class
min_radius			= 5			; [] for AI
max_radius			= 100			; [] for AI
description			= st_wpn_ak74u_descr

ef_main_weapon_type		= 2
ef_weapon_type			= 6

;---DOF-------------------------------------------------------------------------
zoom_dof			= 0.5, 1.0, 180
reload_dof			= 0.0, 0.5, 5, 1.7
;-------------------------------------------------------------------------------

upgrades			= up_gr_ab_ak74u, up_gr_cd_ak74u, up_gr_ef_ak74u, up_gr_i_ak74u
installed_upgrades		=
upgrade_scheme			= upgrade_scheme_u9d

;-------------------------------------------------------------------------------
holder_range_modifier		= 1.0			; во сколько раз увеличивается eye_range
holder_fov_modifier		= 0.7			; во сколько раз увеличивается eye_fov
;-------------------------------------------------------------------------------

cost 				= 2100			; the price of the item
weapon_class			= assault_rifle		; the type of the box that will be used in buy-menu in multiplayer mode

fire_modes 			= 1, -1

ammo_limit			= 210			; obsolete
ammo_current			= 210
ammo_elapsed			= 30			; obsolete
ammo_mag_size 			= 30			; clip (magazine) size

ammo_class 			= ammo_5.45x39_fmj, ammo_5.45x39_ap	; name of the ltx-section of used ammo
grenade_class 			= ammo_vog-25, ammo_vog-25p		; name of the ltx-section of used grenades

launch_speed			= 73.5

hand_dependence			= 2
single_handed			= 0

slot				= 2			; // secondary
animation_slot			= 2			; 8 ; type of the animation that will be used

inv_name 			= st_wpn_ak74u		; name in inventory
inv_name_short 			= st_wpn_ak74u
inv_weight			= 2.71								; weight in inventory

inv_grid_width			= 4			; position and size of the icon that will be used to display weapon in the inventory menu
inv_grid_height			= 2			; all icons are on the texture ui_icon_equipment.dds,
inv_grid_x			= 0			; position and size are in terms of 64x64 squares
inv_grid_y			= 16

kill_msg_x			= 0
kill_msg_y			= 123
kill_msg_width			= 69
kill_msg_height			= 30

;-------------------------------------------------------------------------------
;params of weapon recoil
