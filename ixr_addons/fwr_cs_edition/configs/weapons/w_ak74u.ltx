grenade_flame_particles 	= weapons\generic_weapon01

shell_point		 	= 0.00, 0.262, 0.189		; position (3rd person view) for shell to throw out
shell_particles	 		= weapons\545x39		; name of the particles for shells

PDM_disp_base 			= 1.0
PDM_disp_vel_factor 		= 1.3
PDM_disp_accel_factor 		= 1.3
PDM_disp_crouch	 		= 1.0
PDM_disp_crouch_no_acc		= 1.0

; ttc
hit_power			= 1.0, 1.0, 1.0, 1.0
hit_impulse			= 100				; size of physic impulse by bullet
hit_type			= fire_wound			; [] type of the wound

fire_distance			= 200				; maximum fire distance that bullet can fly
bullet_speed			= 735				; starting bullet speed
rpm				= 700				; max round per minute
rpm_empty_click			= 200
; end ttc

use_aim_bullet			= false				; Поддерживается ли первая суппер пуля
time_to_aim			= 1.0

