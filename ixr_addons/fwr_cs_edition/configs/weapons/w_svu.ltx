;---DOF-------------------------------------------------------------------------
;zoom_dof			= 0.5, 1.0, 350
reload_dof			= 0.0, 0.5, 5, 1.7
;-------------------------------------------------------------------------------

upgrades			= up_gr_a_svu, up_gr_b_svu, up_gr_c_svu, up_gr_d_svu, up_gr_e_svu
installed_upgrades		=
upgrade_scheme			= upgrade_scheme_u7a

;--- scope weapons -----------------------------------------------------------------
holder_range_modifier		= 3.0			; во сколько раз увеличивается eye_range
holder_fov_modifier		= 0.3			; во сколько раз увеличивается eye_fov
;-------------------------------------------------------------------------------

