inv_weight			= 4.4

inv_grid_width			= 5
inv_grid_height			= 2
inv_grid_x			= 0
inv_grid_y			= 2

kill_msg_x			= 0
kill_msg_y			= 59
kill_msg_width			= 80
kill_msg_height			= 26

;-------------------------------------------------------------------------------
;базовая дисперсия
