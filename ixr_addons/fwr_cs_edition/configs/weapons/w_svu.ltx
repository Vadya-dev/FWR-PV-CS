; Снайперская винтовка укороченная СВУ-А (ОЦ-03А)
;-(правлено SR)-------------------------------------
; калибр 				7.62x54 мм
; длина ствола 				520 мм
; магазин				10
; вес без магазина			4.4
; эффективная дальность стрельбы	640 м 
; прицельная дальность			800 м
; дульная скорость пули			800 м/с
; темп стрельбы				650 в/м
;---------------------------------------------------
[wpn_svu]:identity_immunities,weapon_probability,default_weapon_params
GroupControlSection		= spawn_group
discovery_dependency 		=
$spawn				= "weapons\svu"		; option for Level Editor
$npc		 		= on			; option for Level Editor
$prefetch 	 		= 8
scheduled			= off 			; option for ALife Simulator
cform				= skeleton
class				= WP_SVU
min_radius			= 5
max_radius			= 200
description			= st_wpn_svu_descr

ef_main_weapon_type		= 3
