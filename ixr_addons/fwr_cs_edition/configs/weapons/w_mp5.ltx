fire_point		= 0,0.087762,0.375585
fire_bone               = wpn_body
fire_point2		= 0,0,0
fire_bone2              = wpn_body

anm_show                = mp5_draw
anm_hide                = mp5_holster
anm_idle                = mp5_idle
anm_idle_sprint         = mp5_sprint
anm_idle_moving         = mp5_move
