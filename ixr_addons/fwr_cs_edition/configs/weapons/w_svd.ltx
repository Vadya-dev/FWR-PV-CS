; Снайперская винтовка Драгунова СВД	/ СВД-С
;-(правлено SR)-------------------------------------
; калибр 				7.62x54 мм
; длина ствола 				620 мм / 565 мм
; магазин				10
; вес без магазина			4.68 / 4.31
; эффективная дальность стрельбы	800 м 
; прицельная дальность			1300 м / 1200 м
; дульная скорость пули			830 м/с / 810 м
; темп стрельбы				30 в/с
;---------------------------------------------------
[wpn_svd]:identity_immunities,weapon_probability,default_weapon_params
GroupControlSection		= spawn_group
discovery_dependency 		=
$spawn				= "weapons\svd"		; option for Level Editor
$npc		 		= on			; option for Level Editor
$prefetch 	 		= 8
scheduled			= off 			; option for ALife Simulator
cform				= skeleton
class				= WP_SVD
min_radius			= 5
max_radius			= 200
description			= st_wpn_svd_descr

ef_main_weapon_type		= 3
ef_weapon_type			= 8

;---DOF-------------------------------------------------------------------------
;zoom_dof			= 0.5, 1.0, 350
reload_dof			= 0.0, 0.5, 5, 1.7
;-------------------------------------------------------------------------------

upgrades			= up_gr_a_svd, up_gr_b_svd, up_gr_c_svd, up_gr_d_svd, up_gr_e_svd
installed_upgrades		=
upgrade_scheme			= upgrade_scheme_u8

;--- scope weapons -----------------------------------------------------------------
holder_range_modifier		= 3.0			; во сколько раз увеличивается eye_range
holder_fov_modifier		= 0.3			; во сколько раз увеличивается eye_fov
;-------------------------------------------------------------------------------

