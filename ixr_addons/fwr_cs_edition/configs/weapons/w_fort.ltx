; Пистолет Форт-14 			(Форт-14)
;-(правлено SR)-------------------------------------
; калибр 				9x18 мм
; длина ствола 				135 мм
; магазин				14
; вес без магазина			0.920
; эффективная дальность стрельбы	30 м
; прицельная дальность			---
; дульная скорость пули			335 м/с
; темп стрельбы				50 в/с
;---------------------------------------------------
[wpn_fort]:identity_immunities,weapon_probability,default_weapon_params
GroupControlSection		= spawn_group
discovery_dependency 		=
$spawn 				= "weapons\fort"	; option for Level Editor
$npc	 			= on						; option for Level Editor
$prefetch			= 8
scheduled	 		= off 			; option for ALife Simulator
cform 				= skeleton
class 				= WP_PM
min_radius 			= 1
max_radius 			= 10
description			= st_wpn_fort_descr

ef_main_weapon_type		= 0
ef_weapon_type			= 5

;---DOF-------------------------------------------------------------------------
zoom_dof			= -1000, 1.0, 1000 
reload_dof			= 0.0, 0.5, 5, 1.7
;-----------------------------------------------------------------------------

upgrades			= up_gr_ab_fort, up_gr_cd_fort, up_gr_e_fort, up_gr_f_fort, up_gr_g_fort, up_gr_h_fort
installed_upgrades		=
upgrade_scheme			= upgrade_scheme_u10a

;-------------------------------------------------------------------------------
holder_range_modifier		= 1.0			; во сколько раз увеличивается eye_range
holder_fov_modifier		= 1.5			; во сколько раз увеличивается eye_fov
;-------------------------------------------------------------------------------

cost				= 600

ammo_limit			= 120
ammo_current		 	= 90
ammo_elapsed		 	= 14
ammo_mag_size		 	= 14

ammo_class		 	= ammo_9x18_fmj, ammo_9x18_pmm

hand_dependence		 	= 1
single_handed			= 1

slot 			 	= 1
animation_slot			= 1									; type of the animation that will be used

inv_name			= st_wpn_fort
inv_name_short			= st_wpn_fort
inv_weight			= 0.83

inv_grid_width			= 1
inv_grid_height			= 1
inv_grid_x			= 10
inv_grid_y			= 8

kill_msg_x			= 104
kill_msg_y			= 178
kill_msg_width			= 28
kill_msg_height			= 21

;-------------------------------------------------------------------------------
;базовая дисперсия
fire_dispersion_base		= 0.22		;угол (в градусах) базовой дисперсии оружия (оружия зажатого в тисках)

;отдача
cam_relax_speed			= 8		;скорость возврата в исходное положение
cam_relax_speed_ai		= 360
cam_dispersion			= 0.6		;увеличения угла (в градусах) с каждым выстрелом
cam_dispersion_inc		= 0.6		;увеличениe cam_dispersion с каждым выстрелом
cam_dispersion_frac		= 1.0		;ствол будет подыматься на cam_dispersion*cam_dispersion_frac +- cam_dispersion*(1-cam_dispersion_frac)
cam_max_angle			= 5.0		;максимальный угол отдачи
cam_max_angle_horz		= 5.0		;(degree) maximum shot horizontal degree
cam_step_angle_horz		= 1.0		;(degree) size of step camera moved in horizontal position while shooting

fire_dispersion_condition_factor= 10		;увеличение дисперсии в процентах при максимальном износе
misfire_probability 		= 0.003		;вероятность осечки при максимальном износе
misfire_condition_k		= 0.05 
condition_shot_dec 		= 0.00125	;увеличение износа при каждом выстреле

;-------------------------------------------------------------------------------

hud 				= wpn_fort_hud
position 			= -0.021, -0.1, 0.0
orientation 			= 0, 0, 0

fire_point 			= 0.0, 0.148, 0.161

